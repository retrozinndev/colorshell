{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "colorshell",
    "version": "2.1.3",
    "packageManager": "pnpm@11.17.0",
    "scripts": {
        "types": "sh ./scripts/types.sh",
        "dev": "sh ./scripts/build.sh && sh ./scripts/start.sh",
        "start": "sh ./scripts/start.sh",
        "clean": "sh ./scripts/clean.sh",
        "build": "sh ./scripts/build.sh",
        "build:release": "sh ./scripts/build.sh -r",
        "check:nix": "sh ./scripts/nixdeps.sh"
    },
    "devDependencies": {
        "esbuild": "^0.28.1"
    },
    "dependencies": {
        "ags": "file:/usr/share/ags/js",
        "fuse.js": "^7.5.0",
        "gnim-utils": "github:retrozinndev/gnim-utils"
    }
}
